#include <winres.h>

#include "resource.h"

// ---------------------------------------------------------------------------
// Icon and version information
//
// The user interface is built with Qt Widgets (see ui_main.cpp / ui_dialogs.cpp),
// so this resource script only carries the executable icon and version block.
// ---------------------------------------------------------------------------
IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ProSoft"
            VALUE "FileDescription",  "FLEX Download Manager - segmented download manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "flexdm"
            VALUE "LegalCopyright",   "\251 2026 ProSoft. All rights reserved."
            VALUE "OriginalFilename", "FLEX Download Manager.exe"
            VALUE "ProductName",      "FLEX Download Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
